rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for schedules collection
    match /schedules/{document} {
      // Users can only read/write their own schedules
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      // Users can create schedules with their own userId
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Rules for Venues collection (read-only for authenticated users)
    match /Venues/{document} {
      allow read: if request.auth != null;
    }
    
    // Rules for Routes collection (read-only for authenticated users)
    match /Routes/{document} {
      allow read: if request.auth != null;
    }
  }
}